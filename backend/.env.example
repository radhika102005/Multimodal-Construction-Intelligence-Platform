# ==========================================
# Multimodal Construction Intelligence Platform
# Environment Configuration
# ==========================================

# Port and Host (Render automatically sets PORT)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated, e.g. http://localhost:5173,https://your-frontend.vercel.app)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://*.vercel.app

# AI Provider Configuration
# Supported providers: "gemini" (recommended, free tier available), "openai", or "mock" (for offline/demo)
AI_PROVIDER=gemini

# AI API Key (Obtain free key from Google AI Studio: https://aistudio.google.com/app/apikey)
AI_API_KEY=

# Model Name
# For Gemini: gemini-1.5-flash or gemini-2.0-flash
# For OpenAI: gpt-4o-mini
AI_MODEL=gemini-1.5-flash

# Maximum Upload Size in Megabytes (recommended 10 for Render free tier)
MAX_UPLOAD_MB=10

# Request Timeout in Seconds
REQUEST_TIMEOUT_SECONDS=45

# Environment Mode: development / production
ENVIRONMENT=development
