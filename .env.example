# Backend Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
MAX_UPLOAD_MB=10
REQUEST_TIMEOUT_SECONDS=45
ENVIRONMENT=development

# Frontend Configuration (used in frontend/.env)
# In production, replace with your Render backend URL (e.g. https://your-render-service.onrender.com)
VITE_API_BASE_URL=http://localhost:8000
